# Copy this file to a new file called .env and fill in the real values.
# NEVER upload .env to GitHub.

# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the "Session pooler" string; replace [YOUR-PASSWORD] with your DB password.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Frontend address(es) allowed to call this backend, comma-separated.
# Include the Vercel site origin, even when Vercel sends /api to this server.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Supabase Storage. Keep the secret key on the backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_STORAGE_BUCKET=designer-idp-images

PORT=3000
