# Leave empty for same-origin API routing. Vite sends local /api requests to localhost:3000.
# Set this only when the API is deployed at a separate origin, without /api at the end.
VITE_API_URL=

# Public values. The publishable key is safe to use in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
