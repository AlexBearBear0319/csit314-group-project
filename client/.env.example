# Leave empty on your laptop. Vite sends /api requests to localhost:3000.
# On Vercel, set this to the backend origin, for example https://your-api.onrender.com.
VITE_API_URL=

# Public values. The publishable key is safe to use in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
